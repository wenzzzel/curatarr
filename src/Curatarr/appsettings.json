{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Curatarr": "Data Source=curatarr.db"
  },
  "Sonarr": {
    "Url": "http://localhost:8989",
    "ApiKey": "<masked>"
  },
  "Destination": {
    "Root": "/root/folder"
  },
  "Source": {
    "Root": ""
  },
  "Subtitle": {
    "Suffixes": [
      ".en.srt",
      ".eng.srt",
      ".en.sdh.srt",
      ".eng.sdh.srt",
      ".sv.srt",
      ".swe.srt",
      ".sv.sdh.srt",
      ".swe.sdh.srt"
    ]
  }
}
