@page "/series"
@using Curatarr.Services.Diff
@inject SeriesDiffService Diff

<PageTitle>Series</PageTitle>

<h1>Series</h1>

@if (rows is null)
{
    <p>Loading…</p>
}
else if (rows.Count == 0)
{
    <p>Nothing in source or destination yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Source folder</th>
                <th>Destination folder</th>
                <th>Source episodes</th>
                <th>Destination episodes</th>
                <th>Orphaned</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <td>
                        @if (row.SonarrId is { } id)
                        {
                            <a href="/series/@id">@row.Title</a>
                        }
                        else
                        {
                            @row.Title
                        }
                    </td>
                    <td>@(row.SourceFolder ?? "—")</td>
                    <td>@(row.DestinationFolder ?? "—")</td>
                    <td>@row.SourceEpisodes</td>
                    <td>@row.DestinationEpisodes</td>
                    <td>@row.OrphanedFiles</td>
                    <td>@StatusFor(row)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<SeriesDiffRow>? rows;

    protected override async Task OnInitializedAsync()
    {
        rows = await Diff.GetSeriesDiffAsync();
    }

    private static string StatusFor(SeriesDiffRow row) => (row.InSource, row.InDestination) switch
    {
        (false, true) => "Orphaned folder",
        (true, false) => "Missing in destination",
        (true, true) when row.MissingEpisodes == 0 && row.OrphanedFiles == 0 => "OK",
        (true, true) => string.Join(", ", BuildIssues(row)),
        _ => "?",
    };

    private static IEnumerable<string> BuildIssues(SeriesDiffRow row)
    {
        if (row.MissingEpisodes > 0) yield return $"{row.MissingEpisodes} missing";
        if (row.OrphanedFiles > 0) yield return $"{row.OrphanedFiles} orphaned";
    }
}
