@page "/series"
@using Curatarr.Services.Diff
@inject SeriesDiffService Diff

<PageTitle>Series</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Series</MudText>

@if (rows is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="SeriesDiffRow"
                 Items="@rows"
                 Filterable="true"
                 SortMode="SortMode.Multiple"
                 Hover="true"
                 Dense="true"
                 QuickFilter="@QuickFilter"
                 RowsPerPage="25">
        <ToolBarContent>
            <MudTextField @bind-Value="searchString"
                          Placeholder="Search"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Immediate="true"
                          Clearable="true" />
        </ToolBarContent>
        <Columns>
            <TemplateColumn Title="Title" SortBy="@(r => r.Title)">
                <CellTemplate>
                    @if (context.Item.SonarrId is { } id)
                    {
                        <MudLink Href="@($"/series/{id}")">@context.Item.Title</MudLink>
                    }
                    else
                    {
                        @context.Item.Title
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.SourceFolder" Title="Source folder" />
            <PropertyColumn Property="x => x.DestinationFolder" Title="Destination folder" />
            <PropertyColumn Property="x => x.SourceEpisodes" Title="Source eps" />
            <PropertyColumn Property="x => x.DestinationEpisodes" Title="Destination eps" />
            <PropertyColumn Property="x => x.OrphanedFiles" Title="Orphaned" />
            <PropertyColumn Property="x => x.OriginalSubtitles" Title="Original subs" />
            <PropertyColumn Property="x => x.DownloadedSubtitles" Title="Downloaded subs" />
            <PropertyColumn Property="x => x.MissingSubtitles" Title="Missing subs" />
            <TemplateColumn Title="Status" SortBy="@(r => StatusFor(r))">
                <CellTemplate>@StatusFor(context.Item)</CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="SeriesDiffRow" />
        </PagerContent>
        <NoRecordsContent>
            <MudText>Nothing in source or destination yet.</MudText>
        </NoRecordsContent>
    </MudDataGrid>
}

@code {
    private IReadOnlyList<SeriesDiffRow>? rows;
    private string searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        rows = await Diff.GetSeriesDiffAsync();
    }

    private bool QuickFilter(SeriesDiffRow row)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        return row.Title.Contains(searchString, StringComparison.OrdinalIgnoreCase);
    }

    private static string StatusFor(SeriesDiffRow row) => (row.InSource, row.InDestination) switch
    {
        (false, true) => "Orphaned folder",
        (true, false) => "Missing in destination",
        (true, true) when row.MissingEpisodes == 0 && row.OrphanedFiles == 0 && row.MissingSubtitles == 0 => "OK",
        (true, true) => string.Join(", ", BuildIssues(row)),
        _ => "?",
    };

    private static IEnumerable<string> BuildIssues(SeriesDiffRow row)
    {
        if (row.MissingEpisodes > 0) yield return $"{row.MissingEpisodes} missing";
        if (row.OrphanedFiles > 0) yield return $"{row.OrphanedFiles} orphaned";
        if (row.MissingSubtitles > 0) yield return $"{row.MissingSubtitles} missing subs";
    }
}
