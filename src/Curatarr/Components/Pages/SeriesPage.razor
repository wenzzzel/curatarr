@page "/series"
@using Curatarr.Services.Diff
@inject SeriesDiffService Diff

<PageTitle>Series</PageTitle>

<h1>Series</h1>

@if (rows is null)
{
    <p>Loading…</p>
}
else if (rows.Count == 0)
{
    <p>Nothing in source or destination yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Source</th>
                <th>Destination</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in rows)
            {
                <tr>
                    <td>@row.Title</td>
                    <td>@(row.SourceFolder ?? "—")</td>
                    <td>@(row.DestinationFolder ?? "—")</td>
                    <td>@StatusFor(row)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<SeriesDiffRow>? rows;

    protected override async Task OnInitializedAsync()
    {
        rows = await Diff.GetSeriesDiffAsync();
    }

    private static string StatusFor(SeriesDiffRow row) => (row.InSource, row.InDestination) switch
    {
        (true, true) => "OK",
        (true, false) => "Missing in destination",
        (false, true) => "Orphaned in destination",
        _ => "?",
    };
}
