@page "/"
@using Curatarr.Services.Diff
@inject SeriesDiffService SeriesDiff
@inject MovieDiffService MovieDiff

<PageTitle>Curatarr</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Overview</MudText>

@if (seriesStats is null || movieStats is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="6">
            @RenderStatsCard("Series", SeriesSections(seriesStats))
        </MudItem>
        <MudItem xs="12" md="6">
            @RenderStatsCard("Movies", MovieSections(movieStats))
        </MudItem>
    </MudGrid>
}

@code {
    private SeriesStats? seriesStats;
    private MovieStats? movieStats;

    private record SeriesStats(
        int SeriesOk, int SeriesOrphaned, int SeriesMissing, int SeriesNoOriginalSubs,
        int EpisodesOk, int EpisodesOrphaned, int EpisodesMissing,
        int EpisodesMissingSubs, int EpisodesExcessiveSubs, int EpisodesNoOriginalSubs);

    private record MovieStats(int Ok, int Orphaned, int OrphanedFiles, int MissingMovies, int MissingSubs, int ExcessiveSubs, int NoOriginalSubs);

    private record StatsSection(string? Subtitle, (string Label, int Value, Color Color)[] Tiles);

    protected override async Task OnInitializedAsync()
    {
        var seriesTask = SeriesDiff.GetSeriesDiffAsync();
        var movieTask = MovieDiff.GetMoviesDiffAsync();

        var seriesRows = await seriesTask;
        var movieRows = await movieTask;

        seriesStats = new SeriesStats(
            SeriesOk: seriesRows.Count(r => r.IsOk),
            SeriesOrphaned: seriesRows.Count(r => r.IsOrphanedFolder),
            SeriesMissing: seriesRows.Count(r => r.IsMissingInDestination),
            SeriesNoOriginalSubs: seriesRows.Count(r => r.InSource && r.InDestination && r.OriginalSubtitles == 0),
            EpisodesOk: seriesRows.Sum(r => r.OkEpisodes),
            EpisodesOrphaned: seriesRows.Sum(r => r.OrphanedFiles),
            EpisodesMissing: seriesRows.Sum(r => r.MissingEpisodes),
            EpisodesMissingSubs: seriesRows.Sum(r => r.MissingSubtitles),
            EpisodesExcessiveSubs: seriesRows.Sum(r => r.ExcessiveSubtitles),
            EpisodesNoOriginalSubs: seriesRows.Sum(r => r.EpisodesWithoutOriginalSubs));

        movieStats = new MovieStats(
            Ok: movieRows.Count(r => r.IsOk),
            Orphaned: movieRows.Count(r => r.IsOrphanedFolder),
            OrphanedFiles: movieRows.Sum(r => r.OrphanedFiles),
            MissingMovies: movieRows.Count(r => r.IsMissingInDestination),
            MissingSubs: movieRows.Sum(r => r.MissingSubtitles),
            ExcessiveSubs: movieRows.Sum(r => r.ExcessiveSubtitles),
            NoOriginalSubs: movieRows.Count(r => r.InSource && r.InDestination && r.OriginalSubtitles == 0));
    }

    private static StatsSection[] SeriesSections(SeriesStats s) =>
    [
        new("Series",
        [
            ("OK", s.SeriesOk, Color.Success),
            ("Orphaned", s.SeriesOrphaned, Color.Info),
            ("Missing", s.SeriesMissing, Color.Error),
            ("No original subs", s.SeriesNoOriginalSubs, Color.Warning),
        ]),
        new("Episodes",
        [
            ("OK", s.EpisodesOk, Color.Success),
            ("Orphaned", s.EpisodesOrphaned, Color.Warning),
            ("Missing", s.EpisodesMissing, Color.Error),
            ("Missing subs", s.EpisodesMissingSubs, Color.Warning),
            ("Excessive subs", s.EpisodesExcessiveSubs, Color.Warning),
            ("No original subs", s.EpisodesNoOriginalSubs, Color.Warning),
        ]),
    ];

    private static StatsSection[] MovieSections(MovieStats s) =>
    [
        new(null,
        [
            ("OK", s.Ok, Color.Success),
            ("Orphaned", s.Orphaned, Color.Info),
            ("Orphaned files", s.OrphanedFiles, Color.Warning),
            ("Missing movies", s.MissingMovies, Color.Error),
            ("Missing subs", s.MissingSubs, Color.Warning),
            ("Excessive subs", s.ExcessiveSubs, Color.Warning),
            ("No original subs", s.NoOriginalSubs, Color.Warning),
        ]),
    ];

    private RenderFragment RenderStatsCard(string title, StatsSection[] sections) =>
        @<MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-3">@title</MudText>
            @foreach (var block in sections)
            {
                if (block.Subtitle is not null)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-2 mud-text-secondary">@block.Subtitle</MudText>
                }
                <div class="d-flex flex-wrap mb-3" style="gap: 8px;">
                    @foreach (var tile in block.Tiles)
                    {
                        <MudPaper Class="pa-3 d-flex flex-column align-center" Outlined="true" Style="flex: 1 1 110px;">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@tile.Label</MudText>
                            <MudText Typo="Typo.h4" Color="@(tile.Value == 0 && tile.Color != Color.Success ? Color.Default : tile.Color)">@tile.Value</MudText>
                        </MudPaper>
                    }
                </div>
            }
        </MudPaper>;
}
